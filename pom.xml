<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot's parent POM. This is what actually makes it a
         "Spring Boot project" — it manages compatible versions for every
         Spring-related dependency, provides the spring-boot-maven-plugin,
         and sets sensible defaults so we don't have to declare a version
         for every single Spring artifact by hand. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- A known-stable release. If Maven can't resolve this exact
             version, it means a newer patch has superseded it since this
             was written — tell me and we'll bump it, same as we did with
             the JUnit console launcher jar earlier. -->
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.gymmanagement</groupId>
    <artifactId>myfitness</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>MyFitness Gym Management System</name>
    <description>
        Layered Java gym management backend — SQLite persistence, BCrypt
        authentication, JUnit 5 test suite, and a Spring Boot REST API.
    </description>

    <properties>
        <!-- Spring Boot's own convention for the Java version, replacing
             the separate maven.compiler.source/target pair. -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- sqlite-jdbc's slf4j-api dependency is no longer pinned here.
             Maven resolves it automatically now — the explicit pin was
             only ever necessary during the manual-javac phase, when there
             was no tool resolving transitive dependencies for us. -->
        <sqlite-jdbc.version>3.45.1.0</sqlite-jdbc.version>
        <jbcrypt.version>0.4</jbcrypt.version>
    </properties>

    <dependencies>

        <!-- NEW — brings in embedded Tomcat (a small web server bundled
             into your app, no separate install), Spring MVC (the
             @RestController machinery), and Jackson (converts Java
             objects to/from JSON automatically). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Health check endpoint (/actuator/health). Only 'health' is
             exposed publicly by default — everything else (metrics, env,
             beans) stays hidden unless explicitly opted into, which
             matters given this app has no request-level auth enforcement
             yet. See DatabaseHealthIndicator for why the default health
             check alone wasn't enough for this project specifically. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Bean Validation (@NotBlank, @Email, @Positive, etc.) on
             request DTOs. Moves "was this request even well-formed"
             checking to the HTTP boundary, before it reaches a service
             or domain constructor — domain constructors keep their own
             checks too, as a second, independent guard that holds even
             if something else ever constructs these objects without
             going through a controller. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- NEW — JUnit 5 + Spring's own test support, replacing the old
             manually-declared junit-jupiter dependency. Spring Boot's
             parent manages the version for this automatically. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- PostgreSQL JDBC driver — replaces SQLite as the real database. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>

        <!-- SQLite JDBC driver — left in place for now, unused once
             DatabaseManager fully switches to Postgres. Not removing it
             yet on purpose: keeping it doesn't hurt anything, and it stays
             available as a fallback until Postgres is fully proven
             working end-to-end. Safe to delete in a later cleanup pass. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>

        <!-- SLF4J is intentionally NOT declared here anymore.
             It caused a real startup crash: this explicit 1.7.36 pin
             overrode the newer slf4j-api version Spring Boot's own
             Logback-based logging setup requires, and the two versions'
             internal APIs don't match — Spring Boot failed to initialise
             its logger before the server could even start. Removing the
             pin lets sqlite-jdbc's own transitive dependency resolve
             normally, managed consistently by Spring Boot's BOM instead
             of being overridden by an explicit, now-outdated version. -->

        <!-- BCrypt password hashing — unchanged from before -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>${jbcrypt.version}</version>
        </dependency>

    </dependencies>

    <build>
        <finalName>myfitness</finalName>
        <plugins>

            <!-- Makes `mvn spring-boot:run` work, and repackages
                 `mvn package` into a self-contained executable jar
                 (embedded server included).
                 mainClass is set EXPLICITLY here because this project has
                 two classes with a main() method — Main.java (the console
                 demo) and MyFitnessApplication.java (the Spring Boot
                 server). Without pinning this, auto-detection has no
                 reliable way to know which one you actually mean, and can
                 pick the wrong one — which is exactly what happened the
                 first time this ran. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.gymmanagement.MyFitnessApplication</mainClass>
                </configuration>
            </plugin>

            <!-- Runs `mvn test` — unchanged from before -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- Still here so `mvn compile exec:java` keeps running the
                 original console app (com.gymmanagement.Main) exactly as
                 before — nothing about the old entry point is being
                 removed or broken today. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>com.gymmanagement.Main</mainClass>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>